{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "check": "npm run lint && npm run build",
    "test:procurement": "node --import tsx --test tests/procurement.test.ts",
    "build:workers": "vite build --outDir build/client",
    "dev:workers": "wrangler dev",
    "check:workers": "npm run lint && npm run build:workers && wrangler deploy --dry-run --outdir build/worker",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy:workers": "npm run build:workers && npm run db:migrate:remote && wrangler deploy",
    "test:workers": "node --import tsx --test tests/cloudflareStorage.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261031.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "miniflare": "5.20261023.3-beta",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wrangler": "4.156.0"
  },
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10"
  },
  "overrides": {
    "iconv-lite": "0.6.3"
  }
}
